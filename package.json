{
  "name": "su3-web-materials",
  "version": "0.0.0",
  "description": "Web Components built with Lit: a themable component catalog with design tokens, shown in Storybook.",
  "keywords": [
    "web-components",
    "lit",
    "custom-elements",
    "design-system",
    "design-tokens",
    "storybook"
  ],
  "homepage": "https://github.com/su3-hokkaido/su3-web-materials#readme",
  "bugs": {
    "url": "https://github.com/su3-hokkaido/su3-web-materials/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/su3-hokkaido/su3-web-materials.git"
  },
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26 <27",
      "onFail": "error"
    }
  },
  "files": [
    "dist",
    "!dist/storybook"
  ],
  "sideEffects": [
    "./dist/shared/all.js",
    "./dist/shared/components/*/*/index.js",
    "*.css"
  ],
  "types": "./dist/shared/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/shared/index.d.ts",
      "default": "./dist/shared/index.js"
    },
    "./all.js": {
      "types": "./dist/shared/all.d.ts",
      "default": "./dist/shared/all.js"
    },
    "./button.js": {
      "types": "./dist/shared/components/buttons/button/index.d.ts",
      "default": "./dist/shared/components/buttons/button/index.js"
    },
    "./acme": {
      "types": "./dist/products/acme/index.d.ts",
      "default": "./dist/products/acme/index.js"
    },
    "./sample": {
      "types": "./dist/products/sample/index.d.ts",
      "default": "./dist/products/sample/index.js"
    },
    "./tokens.css": "./dist/tokens.css",
    "./themes/acme.css": "./dist/themes/acme.css",
    "./themes/sample.css": "./dist/themes/sample.css",
    "./custom-elements.json": "./dist/custom-elements.json",
    "./package.json": "./package.json"
  },
  "customElements": "./dist/custom-elements.json",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "analyze": "cem analyze",
    "build": "pnpm run analyze && tsdown && node scripts/build-package-assets.ts",
    "dev": "pnpm run analyze && storybook dev -p 5070",
    "build-storybook": "pnpm run analyze && storybook build",
    "build-storybook:all": "pnpm run analyze && node scripts/build-storybook-all.ts",
    "preview:workers": "wrangler dev --config deploy/cloudflare/wrangler.jsonc",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "ci": "pnpm run analyze && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build && pnpm run check:package && pnpm run build-storybook:all",
    "sync:exports": "node scripts/sync-package-exports.ts",
    "check:package": "node scripts/check-package.ts",
    "check:consumers": "node scripts/check-consumers.ts",
    "new-product": "node scripts/new-product.ts"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "@storybook/addon-a11y": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "@storybook/addon-themes": "10.6.2",
    "@storybook/web-components-vite": "10.6.2",
    "@types/node": "26.6.5",
    "@vitest/browser-playwright": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-import-resolver-typescript": "4.4.5",
    "eslint-plugin-import-x": "4.17.1",
    "eslint-plugin-storybook": "10.6.2",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "publint": "0.3.25",
    "storybook": "10.6.2",
    "tsdown": "0.23.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.5",
    "wrangler": "4.151.3"
  }
}
