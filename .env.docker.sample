# Settings for docker compose. `make setup` copies this file to .env.docker, which is not
# committed. Variables passed on the command line (e.g. `make dev PRODUCT_ID=...`) take precedence.
# Nothing here is a secret: the catalog is a static site and needs none (docs/project_plan.md
# section 7).

# Host port for the Storybook dev server (`make dev`, `make up`).
DEV_PORT=5070

# Host port for the nginx preview of the production build (`make preview`, added in Phase 3).
PREVIEW_PORT=5071

# Product whose stories are shown by the dev server. Must exist under src/products (products are
# introduced in Phase 3; until then only the shared stories are shown).
PRODUCT_ID=sample
